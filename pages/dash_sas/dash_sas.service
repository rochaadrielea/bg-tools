# /etc/systemd/system/dash_sas.service
# Serves the SAS NC dashboard on 127.0.0.1:8503; nginx exposes it at /sas.
# Edit User= and the two paths to match the server, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now dash_sas
[Unit]
Description=SAS NC Dashboard (FastAPI)
After=network.target

[Service]
User=bl3914_op1@ruaggroup.com
WorkingDirectory=/home/bl3914_op1@ruaggroup.com/bgtools/pages/dash_sas/app
ExecStart=/home/bl3914_op1@ruaggroup.com/bgtools/pages/dash_sas/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8503
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
